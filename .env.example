# VIGIL environment variables
# Copy to .env and fill in real values — never commit .env

# ── Backend ─────────────────────────────────────────────────────────────── #
API_HOST=0.0.0.0
API_PORT=8000
SQLITE_PATH=./vigil.db

# ── Frontend origin (set to Vercel URL in production) ────────────────────── #
VITE_ORIGIN=http://localhost:5173

# ── Rime voice API ────────────────────────────────────────────────────────── #
RIME_API_KEY=your_rime_key_here

# ── Qdrant vector DB ─────────────────────────────────────────────────────── #
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Local LLM (Ollama default, swap for OpenAI-compatible endpoint) ─────── #
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
